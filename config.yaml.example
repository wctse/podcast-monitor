podcasts:
  poll_interval_seconds: 3600        # how often to check for new episodes
  max_pages_per_scan: 2              # index pages to scan per podcast
  max_transcript_chars: 100000       # full episodes; tune down if LLM is slow/costly
  http_timeout_seconds: 30
  confidence_threshold: 0.7          # default; can override per source

  sources:
    # - name: "We Study Billionaires"
    #   slug: "we-study-billionaires"
    #   enabled: true


llm:
  provider: "api"                        # "api" for OpenRouter/Groq/OpenAI-compat, "ollama" for local
  base_url: "https://openrouter.ai/api/v1"
  model: "qwen/qwen3.5-9b"
  api_key: ""                            # or set OPENROUTER_API_KEY env var and read below
  timeout: 180                           # longer than Telegram monitor — full transcripts are big
  prompt_file: "prompt.txt"             # private prompt file (gitignored); falls back to prompt/example/default

  # Optional fallback if prompt_file does not exist
  # prompt: |
  #   Analyze transcript and return JSON...


deepgram:
  api_key: ""                         # or set DEEPGRAM_API_KEY env var
  model: "nova-2"
  language: "en"
  timeout_seconds: 900               # seconds to wait for Deepgram to transcribe the full episode
  punctuate: true
  paragraphs: true
  smart_format: true
  utterances: true


telegram:
  bot_token: ""  # same token as telegram-channel-monitor
  target_channel_id: null  # Telegram channel ID for all normal outbound messages


admin:
  chat_id: null        # Your personal Telegram chat ID (find it via @userinfobot)


error_alerts:
  enabled: false       # If true, send system error alerts to admin.chat_id


data:
  db_path: "data/episodes.db"   # episode deduplication DB (separate from telegram-channel-monitor)
